# ---- LLM ----
# Leave blank to run fully offline with deterministic fallback embeddings + a
# stub generator (good for a quick demo / CI). Set a real key for full quality.
OPENAI_API_KEY=

# ---- Postgres ----
POSTGRES_USER=rag
POSTGRES_PASSWORD=rag
POSTGRES_DB=rag

# ---- Retrieval / chunking knobs ----
CHUNKING_STRATEGY=recursive
DENSE_WEIGHT=1.0
SPARSE_WEIGHT=1.0
RERANK_TOP_K=5

# ---- Frontend ----
VITE_API_BASE=http://localhost:8000/v1
