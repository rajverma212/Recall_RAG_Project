# ============================================================
#  Hybrid RAG Platform — environment configuration
#  Everything works with NO keys set (deterministic local
#  providers); add a key to switch to a real model/provider.
# ============================================================

# ----- LLM provider: anthropic | openai | local -----
LLM_PROVIDER=anthropic

# Anthropic (default). With only this key set, the whole platform —
# generation, citation verification, answer judging, eval scoring — runs on Claude.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
# ANTHROPIC_JUDGE_MODEL=          # optional larger model for judging; blank = reuse above
# ANTHROPIC_USE_THINKING=false    # adaptive thinking on verify/judge/score calls

# OpenAI (alternative generation provider)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ----- Embedding provider: openai | bge | voyage | local -----
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536                 # MUST match the model (bge-small=384, voyage-3=1024)
# BGE_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5   # local, no key (set EMBEDDING_DIM=384)
# VOYAGE_API_KEY=

# ----- Runtime environment: local | ci | production -----
# In `production`, a silent provider downgrade (e.g. LLM_PROVIDER=anthropic with
# no key) or an embedding-dimension mismatch aborts startup. local/ci degrade
# gracefully to the offline local providers.
ENVIRONMENT=local

# ----- CORS -----
# Browser origins allowed to call the API (comma-separated). "*" allows any
# origin (local Docker / public demo). In production pin it to the frontend:
# ALLOWED_ORIGINS=https://recall.vercel.app
ALLOWED_ORIGINS=*

# ----- Rate limiting (per client IP) -----
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_DEFAULT=200/minute   # all routes except liveness /health
# RATE_LIMIT_ASK=15/minute        # /v1/ask + /v1/ask/stream (LLM spend)

# ----- Admin guard (optional; OFF by default) -----
# Reading and asking are always open (no sign-in) so anyone can try the demo.
# Leave ADMIN_API_KEY blank and the destructive/expensive routes (ingest, delete
# corpus/document, run evaluation) stay open too. Set it to a secret and those
# routes require an `X-Admin-Key: <value>` header — the provision for locking the
# app down later without adding a login wall.
# ADMIN_API_KEY=

# ----- Uploads -----
# MAX_UPLOAD_BYTES=10485760        # hard cap per ingested file (default 10 MiB)

# ----- Postgres -----
POSTGRES_USER=rag
POSTGRES_PASSWORD=rag
POSTGRES_DB=rag
# In production set the full connection target (Railway/Neon provide these):
# POSTGRES_HOST=...
# POSTGRES_PORT=5432

# ----- Qdrant -----
# Local Docker uses QDRANT_HOST/PORT. For Qdrant Cloud, set QDRANT_URL +
# QDRANT_API_KEY instead (takes precedence; connects over TLS with auth).
# QDRANT_URL=https://xxxx.cloud.qdrant.io:6333
# QDRANT_API_KEY=

# ----- Retrieval / chunking knobs -----
CHUNKING_STRATEGY=recursive
DENSE_WEIGHT=1.0
SPARSE_WEIGHT=1.0
RERANK_TOP_K=5

# ----- Frontend -----
VITE_API_BASE=/v1
